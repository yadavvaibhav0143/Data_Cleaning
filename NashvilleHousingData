USE [Portfolio Project];
GO

-- =============================================================================================
-- STEP 1: STANDARDIZE DATE FORMATS
-- =============================================================================================

ALTER TABLE Nashville_Housing_Data ALTER COLUMN SaleDate DATE;
GO

-- [VALIDATION 1] Confirm data type converted and dates display uniformly
SELECT TOP 5 SaleDate 
FROM Nashville_Housing_Data;
GO


-- =============================================================================================
-- STEP 2: POPULATE MISSING PROPERTY ADDRESS DATA
-- =============================================================================================

UPDATE a
SET PropertyAddress = ISNULL(a.PropertyAddress, b.PropertyAddress)
FROM Nashville_Housing_Data a
JOIN Nashville_Housing_Data b
	ON a.ParcelID = b.ParcelID
	AND a.UniqueID <> b.UniqueID
WHERE a.PropertyAddress IS NULL OR a.PropertyAddress = '';
GO

-- [VALIDATION 2] Verify that no unpopulated or blank Property Addresses remain
SELECT COUNT(*) AS UnpopulatedAddresses 
FROM Nashville_Housing_Data 
WHERE PropertyAddress IS NULL OR PropertyAddress = '';
GO


-- =============================================================================================
-- STEP 3: PARSE PROPERTY ADDRESS (Street, City)
-- =============================================================================================

ALTER TABLE Nashville_Housing_Data ADD PropertySplitAddress VARCHAR(200);
ALTER TABLE Nashville_Housing_Data ADD PropertySplitCity VARCHAR(100);
GO

UPDATE Nashville_Housing_Data
SET PropertySplitAddress = CASE 
        WHEN PropertyAddress IS NULL OR PropertyAddress = '' THEN NULL
        WHEN CHARINDEX(',', PropertyAddress) = 0 THEN PropertyAddress
        ELSE SUBSTRING(PropertyAddress, 1, CHARINDEX(',', PropertyAddress) - 1) 
    END,
    PropertySplitCity = CASE 
        WHEN PropertyAddress IS NULL OR PropertyAddress = '' THEN NULL 
        WHEN CHARINDEX(',', PropertyAddress) = 0 THEN NULL 
        ELSE LTRIM(SUBSTRING(PropertyAddress, CHARINDEX(',', PropertyAddress) + 1, LEN(PropertyAddress))) 
    END;
GO

-- [VALIDATION 3] Confirm side-by-side structural parsing success (Comparing Raw vs. Clean)
SELECT TOP 5 PropertyAddress, PropertySplitAddress, PropertySplitCity 
FROM Nashville_Housing_Data;
GO

-- =============================================================================================
-- Step 4A: Add columns safely only if they do not exist yet
-- =============================================================================================
IF NOT EXISTS (SELECT * FROM sys.columns WHERE object_id = OBJECT_ID('Nashville_Housing_Data') AND name = 'OwnerSplitAddress')
BEGIN
    ALTER TABLE Nashville_Housing_Data ADD OwnerSplitAddress VARCHAR(200);
    ALTER TABLE Nashville_Housing_Data ADD OwnerSplitCity VARCHAR(100);
    ALTER TABLE Nashville_Housing_Data ADD OwnerSplitState VARCHAR(50);
END;
GO

-- =============================================================================================
-- Step 4B: Tokenize multi-delimited owner data strings
-- =============================================================================================
UPDATE Nashville_Housing_Data
SET OwnerSplitAddress = PARSENAME(REPLACE(OwnerAddress, ',', '.'), 3),
    OwnerSplitCity = LTRIM(PARSENAME(REPLACE(OwnerAddress, ',', '.'), 2)),
    OwnerSplitState = LTRIM(PARSENAME(REPLACE(OwnerAddress, ',', '.'), 1));
GO

-- [VALIDATION 4] Confirm side-by-side structural parsing success
SELECT TOP 5 OwnerAddress, OwnerSplitAddress, OwnerSplitCity, OwnerSplitState 
FROM Nashville_Housing_Data;
GO


-- =============================================================================================
-- STEP 5: STANDARDIZE BOOLEAN EXPRESSIONS (SoldAsVacant)
-- =============================================================================================

UPDATE Nashville_Housing_Data
SET SoldAsVacant = CASE 
    WHEN SoldAsVacant = 'Y' THEN 'Yes'
    WHEN SoldAsVacant = 'N' THEN 'No'
    ELSE SoldAsVacant
END;
GO

-- [VALIDATION 5] Audit the categorical field to prove only uniform outputs ('Yes', 'No') remain
SELECT DISTINCT SoldAsVacant, COUNT(SoldAsVacant) as ItemCount
FROM Nashville_Housing_Data
GROUP BY SoldAsVacant;
GO


-- =============================================================================================
-- STEP 6: REMOVE DUPLICATE RECORDS
-- =============================================================================================

WITH RowNumCTE AS (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY ParcelID, 
                         PropertyAddress, 
                         SalePrice, 
                         SaleDate, 
                         LegalReference
            ORDER BY UniqueID
        ) as row_num
    FROM Nashville_Housing_Data
)
DELETE FROM RowNumCTE
WHERE row_num > 1;
GO

-- [VALIDATION 6] Re-run window check to guarantee zero overlapping keys remain
WITH DuplicateAuditCTE AS (
    SELECT *,
        ROW_NUMBER() OVER (
            PARTITION BY ParcelID, PropertyAddress, SalePrice, SaleDate, LegalReference
            ORDER BY UniqueID
        ) as row_num
    FROM Nashville_Housing_Data
)
SELECT COUNT(*) AS RemainingDuplicates 
FROM DuplicateAuditCTE 
WHERE row_num > 1;
GO


-- =============================================================================================
-- STEP 7: PRODUCTION READY VIEW
-- Note: Raw columns are explicitly preserved to demonstrate parsing transform capability
-- =============================================================================================

SELECT * FROM Nashville_Housing_Data;
GO
